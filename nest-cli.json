{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api/tsconfig.app.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "introspectComments": true
        }
      }
    ]
  },
  "monorepo": true,
  "root": "apps/api",
  "projects": {
    "modules": {
      "type": "application",
      "root": "modules",
      "entryFile": "index",
      "sourceRoot": "modules",
      "compilerOptions": {
        "deleteOutDir": true,
        "tsConfigPath": "modules/tsconfig.app.json",
        "builder": "tsc",
        "webpack": false,
        "typeCheck": true
      }
    },
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json",
        "webpackConfigPath": ".webpack/webpack-swc.config.js",
        "typeCheck": true,
        "assets": [
          "prosessor/proto/*.proto"
        ],
        "watchAssets": true,
        "deleteOutDir": true
      }
    },
    "api-prod": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json",
        "webpackConfigPath": ".webpack/webpack.prod.js",
        "typeCheck": true,
        "assets": [
          "prosessor/proto/*.proto"
        ],
        "watchAssets": true,
        "deleteOutDir": true
      }
    },
    "cli": {
      "type": "application",
      "root": "apps/cli",
      "entryFile": "main",
      "sourceRoot": "apps/cli/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cli/tsconfig.app.json",
        "webpackConfigPath": ".webpack/webpack-swc.config.js",
        "typeCheck": true
      }
    },
    "common": {
      "type": "application",
      "root": "common",
      "entryFile": "index",
      "sourceRoot": "common/src",
      "compilerOptions": {
        "tsConfigPath": "common/tsconfig.app.json"
      }
    },
    "mongodb": {
      "type": "library",
      "root": "libs/mongodb",
      "entryFile": "index",
      "sourceRoot": "libs/mongodb/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mongodb/tsconfig.lib.json"
      }
    },
    "redis-cache": {
      "type": "library",
      "root": "libs/redis-cache",
      "entryFile": "index",
      "sourceRoot": "libs/redis-cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis-cache/tsconfig.lib.json"
      }
    },
    "redis-client": {
      "type": "library",
      "root": "libs/redis-client",
      "entryFile": "index",
      "sourceRoot": "libs/redis-client/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis-client/tsconfig.lib.json"
      }
    },
    "casl": {
      "type": "library",
      "root": "libs/casl",
      "entryFile": "index",
      "sourceRoot": "libs/casl/src",
      "compilerOptions": {
        "tsConfigPath": "libs/casl/tsconfig.lib.json"
      }
    }
  }
}