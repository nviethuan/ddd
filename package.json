{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:api": "nest build api",
    "build:api:watch": "nest build api --watch",
    "build:api:prod": "NODE_ENV=production nest build api-prod",
    "precli": "nest build cli",
    "build:cli:prod": "NODE_ENV=production nest build cli-prod",
    "start": "nest start",
    "dev": "npm run start:api:debug",
    "start:api:dev": "nest start api --watch",
    "start:api:debug": "nest start api --debug --watch",
    "start:api:prod": "node dist/apps/api/main",
    "cli": "node dist/apps/cli/main",
    "start:docs:dev": "nest start open-api --debug --watch",
    "gen:docs": "nest start open-api",
    "format": "prettier --write \"apps/**/*.ts\" \"modules/**/*.ts\" \"utils/**/*.ts\"",
    "lint": "eslint \"{src,apps,modules}/**/*.ts\" --fix",
    "docs:venv": "sh ./scripts/venv.sh",
    "vtest": "vitest run",
    "vtest:watch": "vitest",
    "vtest:cov": "vitest run --coverage",
    "vtest:debug": "vitest --inspectBrk --inspect --logHeapUsage --no-file-parallelism",
    "vtest:e2e": "vitest run --config ./vitest.config.e2e.mts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.2.7",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "mongoose": "^8.2.4",
    "nest-commander": "^3.15.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@swc/core": "^1.7.14",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.5",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "swc-loader": "^0.2.6",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.0.5",
    "webpack": "^5.94.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/modules/",
      "<rootDir>/common/",
      "<rootDir>/libs/",
      "<rootDir>/utils/"
    ],
    "moduleNameMapper": {
      "^@app/mongodb(|/.*)$": "<rootDir>/libs/mongodb/src/$1",
      "^@common/(.*)$": "<rootDir>/common/src/$1",
      "^@modules/user(|/.*)$": "<rootDir>/modules/user/src/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1"
    }
  }
}
